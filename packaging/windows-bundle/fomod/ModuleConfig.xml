<?xml version="1.0" encoding="utf-8"?>
<config installerVersion="5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>SlideSmith Windows Bundle</moduleName>
  <installSteps order="Explicit">
    <installStep name="Install SlideSmith">
      <optionalFileGroups order="Explicit">
        <group name="Bundle">
          <plugins order="Explicit">
            <plugin name="Desktop + CLI">
              <description>Installs the SlideSmith desktop GUI and CLI into this managed mod folder for Mod Organizer 2 or Vortex. After installation, point your mod manager executable entry at desktop/SlideSmith.exe or cli/SlideSmith-CLI.exe inside the installed SlideSmith bundle.</description>
              <files>
                <folder source="desktop" destination="desktop" priority="0" />
                <folder source="cli" destination="cli" priority="0" />
                <folder source="meta" destination="meta" priority="0" />
                <file source="README.md" destination="README.md" priority="0" />
                <file source="meta.ini" destination="meta.ini" priority="0" />
              </files>
              <conditionFlags />
              <typeDescriptor>
                <type name="Required" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
