{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SlideSmith external proof result bundle",
  "description": "Imported external observations and evidence references. A structurally valid bundle does not establish that the recorded behavior is correct.",
  "type": "object",
  "required": [
    "ContractVersion",
    "HarnessKind",
    "OverallStatus",
    "Host",
    "ComponentResults",
    "ScenarioResults",
    "ProbeResults",
    "MissingExpectedArtifacts",
    "MissingExpectedScenarios",
    "MissingExpectedProbes",
    "MissingExpectedFlows",
    "Notes"
  ],
  "properties": {
    "ContractVersion": { "const": "1.0" },
    "HarnessKind": { "type": "string", "minLength": 1 },
    "OverallStatus": { "type": "string", "minLength": 1 },
    "Host": {
      "type": "object",
      "required": [ "OperatingSystem", "HarnessRunner", "Capabilities" ],
      "properties": {
        "OperatingSystem": { "type": "string", "minLength": 1 },
        "HarnessRunner": { "type": "string", "minLength": 1 },
        "Launcher": { "type": [ "string", "null" ] },
        "ModManager": { "type": [ "string", "null" ] },
        "SaveProfile": { "type": [ "string", "null" ] },
        "ObservationMode": { "type": [ "string", "null" ] },
        "Capabilities": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": true
    },
    "ComponentResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "Component", "Status", "ExecutedItems", "MissingItems", "EvidenceArtifacts", "Notes" ],
        "properties": {
          "Component": { "type": "string", "minLength": 1 },
          "Status": { "type": "string", "minLength": 1 },
          "ExecutedItems": { "$ref": "#/$defs/stringList" },
          "MissingItems": { "$ref": "#/$defs/stringList" },
          "EvidenceArtifacts": { "$ref": "#/$defs/stringList" },
          "Notes": { "$ref": "#/$defs/stringList" }
        },
        "additionalProperties": true
      }
    },
    "ScenarioResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "Scenario", "Status", "ValidationSaveProfile", "ObservedSignals", "MissingSignals", "EvidenceArtifacts", "Notes" ],
        "properties": {
          "Scenario": { "type": "string", "minLength": 1 },
          "Status": { "type": "string", "minLength": 1 },
          "ValidationSaveProfile": { "type": "string", "minLength": 1 },
          "ObservedSignals": { "$ref": "#/$defs/stringList" },
          "MissingSignals": { "$ref": "#/$defs/stringList" },
          "EvidenceArtifacts": { "$ref": "#/$defs/stringList" },
          "Notes": { "$ref": "#/$defs/stringList" }
        },
        "additionalProperties": true
      }
    },
    "ProbeResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "ProbeId", "Status", "ObservedSignals", "MissingSignals", "EvidenceArtifacts", "Notes" ],
        "properties": {
          "ProbeId": { "type": "string", "minLength": 1 },
          "Status": { "type": "string", "minLength": 1 },
          "ObservedSignals": { "$ref": "#/$defs/stringList" },
          "MissingSignals": { "$ref": "#/$defs/stringList" },
          "EvidenceArtifacts": { "$ref": "#/$defs/stringList" },
          "Notes": { "$ref": "#/$defs/stringList" }
        },
        "additionalProperties": true
      }
    },
    "MissingExpectedArtifacts": { "$ref": "#/$defs/stringList" },
    "MissingExpectedScenarios": { "$ref": "#/$defs/stringList" },
    "MissingExpectedProbes": { "$ref": "#/$defs/stringList" },
    "MissingExpectedFlows": { "$ref": "#/$defs/stringList" },
    "Notes": { "$ref": "#/$defs/stringList" }
  },
  "additionalProperties": true,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
