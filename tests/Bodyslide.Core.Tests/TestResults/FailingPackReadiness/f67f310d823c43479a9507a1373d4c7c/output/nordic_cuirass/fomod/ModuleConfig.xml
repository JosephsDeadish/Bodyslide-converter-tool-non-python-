            <folder source="textures" destination="textures" priority="0" />
            <folder source="SKSE" destination="SKSE" priority="0" />
            <file source="preview.svg" destination="preview.svg" priority="0" />
            <file source="preview.html" destination="preview.html" priority="0" />
            <file source="preview-workbench.html" destination="preview-workbench.html" priority="0" />
            <file source="README.txt" destination="README.txt" priority="0" />
            <file source="meta.ini" destination="meta.ini" priority="0" />
            <file source="conversion-quality.json" destination="conversion-quality.json" priority="0" />
            <file source="remaining-gaps-checklist.md" destination="remaining-gaps-checklist.md" priority="0" />
  </requiredInstallFiles>
</config>